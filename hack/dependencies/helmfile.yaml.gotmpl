---
repositories:
  - name: jetstack
    url: https://charts.jetstack.io
  - name: kedacore
    url: https://kedacore.github.io/charts
  - name: open-telemetry
    url: https://open-telemetry.github.io/opentelemetry-helm-charts
  - name: seaweedfs
    url: https://seaweedfs.github.io/seaweedfs/helm

releases:
  - name: cert-manager
    namespace: cert-manager
    chart: jetstack/cert-manager
    version: v1.16.2
    createNamespace: true
    wait: true
    timeout: 600
    values:
      - crds:
          enabled: true

  # Envoy Gateway provides the Gateway API data plane and activation metrics.
  - name: envoy-gateway
    namespace: envoy-gateway-system
    chart: oci://docker.io/envoyproxy/gateway-helm
    version: v1.8.2
    createNamespace: true
    wait: true
    timeout: 600
    values:
      - config:
          envoyGateway:
            extensionApis:
              disableLua: false
    hooks:
      # Apply Gateway resources after their CRDs are installed. Server-side
      # admission still validates resources when client validation is disabled.
      - events: ["postsync"]
        showlogs: true
        command: kubectl
        args:
          - apply
          - --validate=false
          - -f
          - gateway.yaml

  - name: opentelemetry-operator
    namespace: opentelemetry-operator-system
    chart: open-telemetry/opentelemetry-operator
    version: 0.101.0
    createNamespace: true
    wait: true
    timeout: 600
    needs:
      - cert-manager/cert-manager
    values:
      - manager:
          collectorImage:
            repository: otel/opentelemetry-collector-k8s

  - name: keda
    namespace: keda
    chart: kedacore/keda
    version: 2.18.1
    createNamespace: true
    wait: true
    timeout: 600

  - name: kedify-otel
    namespace: keda
    chart: oci://ghcr.io/kedify/charts/otel-add-on
    version: v0.0.6
    createNamespace: false
    wait: true
    timeout: 600
    needs:
      - keda/keda
    values:
      - validatingAdmissionPolicy:
          enabled: false

  - name: kserve-crd
    namespace: kserve-system
    chart: oci://ghcr.io/kserve/charts/kserve-crd
    version: v0.20.0
    createNamespace: true
    wait: true
    timeout: 600
    needs:
      - keda/kedify-otel

  # KServe ships the InferenceService controller as kserve-resources since v0.17;
  # the release keeps its historical name.
  - name: kserve
    namespace: kserve-system
    chart: oci://ghcr.io/kserve/charts/kserve-resources
    version: v0.20.0
    createNamespace: false
    wait: true
    waitForJobs: true
    disableValidation: true
    timeout: 600
    needs:
      - kserve-system/kserve-crd
      - cert-manager/cert-manager
    values:
      - kserve:
          controller:
            deploymentMode: Standard
            gateway:
              ingressGateway:
                enableGatewayApi: false
          localmodel:
            enabled: false
          # Remove default resource limits/requests for inference services
          # Let workloads set their own resources as needed
          # See: helm show values oci://ghcr.io/kserve/charts/kserve-resources
          inferenceservice:
            resources:
              limits:
                cpu: ""
                memory: ""
              requests:
                cpu: ""
                memory: ""

  # KServe LLMInferenceService controller, installed by default so AIM Engine's
  # LLMInferenceService support (spec.servingAPI=LLMInferenceService and the
  # projected LLMInferenceServiceConfigs) is exercised by the default e2e lanes.
  # The InferenceService release above owns the resources both controllers
  # share (inferenceservice-config, cert-manager issuer, ClusterStorageContainer
  # CRD), mirroring KServe's own combined installer.
  - name: kserve-llmisvc-crd
    namespace: kserve-system
    chart: oci://ghcr.io/kserve/charts/kserve-llmisvc-crd
    version: v0.20.0
    wait: true
    timeout: 600
    needs:
      - kserve-system/kserve

  - name: kserve-llmisvc
    namespace: kserve-system
    chart: oci://ghcr.io/kserve/charts/kserve-llmisvc-resources
    version: v0.20.0
    wait: true
    timeout: 600
    needs:
      - kserve-system/kserve-llmisvc-crd
    values:
      - kserve:
          createSharedResources: false

  # KServe's built-in LLMInferenceServiceConfig base templates (for example
  # kserve-config-llm-template), which KServe merges under every
  # LLMInferenceService. ServingRuntimes stay disabled: AIM Engine projects its
  # own.
  - name: kserve-llmisvc-configs
    namespace: kserve-system
    chart: oci://ghcr.io/kserve/charts/kserve-runtime-configs
    version: v0.20.0
    wait: true
    timeout: 600
    needs:
      - kserve-system/kserve-llmisvc
    postRenderer: ./kserve-namespace-post-renderer.sh
    hooks:
      - events: ["presync"]
        showlogs: true
        command: ./wait-for-llmisvc-webhook.sh
        args:
          - kserve-system
    values:
      - kserve:
          llmisvcConfigs:
            enabled: true
          servingruntime:
            enabled: false

  - name: seaweedfs
    namespace: seaweedfs-system
    chart: seaweedfs/seaweedfs
    version: 4.19.0
    createNamespace: true
    wait: true
    timeout: 300
    values:
      - master:
          replicas: 1
          affinity: ""
          data:
            type: emptyDir
        volume:
          replicas: 1
          affinity: ""
          data:
            type: emptyDir
        filer:
          replicas: 1
          affinity: ""
          s3:
            enabled: true
            enableAuth: false
          data:
            type: emptyDir