# Tiltfile for aim-engine operator development
#
# Usage:
#   make tilt-up              # Normal mode (fast in-container rebuilds)
#   make tilt-up-debug        # Debug mode (Delve attached)
#   make tilt-down            # Tear down
#
# How it works:
#   1. Builds a dev image with Go toolchain (pushed to ttl.sh or loaded to Kind)
#   2. Deploys to cluster with PVC for Go build cache
#   3. On file changes: syncs files → rebuilds in container → restarts process
#   4. No image push/pull on incremental changes - just file sync!

load('ext://restart_process', 'docker_build_with_restart')

# ============================================================================
# Allowed Kubernetes Contexts
# ============================================================================

# Only allow development contexts (Kind and vcluster)
# This prevents accidental deployment to production clusters
ctx = k8s_context()
if ctx.startswith('kind-') or ctx.startswith('vcluster_'):
    allow_k8s_contexts(ctx)
else:
    fail('Context "%s" is not allowed. Only kind-* and vcluster_* contexts are permitted.' % ctx)

# ============================================================================
# Configuration
# ============================================================================

config.define_bool("debug", usage="Enable debug mode with Delve debugger")
cfg = config.parse()

DEBUG_MODE = cfg.get("debug", False)

# Root of the project (two levels up from hack/tilt)
ROOT = "../.."

# Image name - must match what kustomize outputs (see kustomize/kustomization.yaml images section)
IMAGE_NAME = "ttl.sh/aim-placeholder/manager:tilt"

VERSION = str(local(
    'git describe --tags --abbrev=0 2>/dev/null || echo dev',
    quiet=True,
    dir=ROOT,
)).strip()

# ============================================================================
# Artifact-downloader image
# ============================================================================
#
# Build the downloader from local source every Tilt run so changes under
# images/artifact-downloader/** ship to the cluster without manual rebuilds.
# We compute a content-addressed tag (sha256 of the source tree) and:
#   1. Build & push that exact tag to ttl.sh (registry shared with the
#      operator image).
#   2. Bake the same tag into the operator binary's DefaultDownloadImage
#      via LDFLAGS so download Jobs pull THIS build, not the registry-side
#      `:latest` (which is built only on releases and lags main).
#
# Content-addressing avoids the stale-cache trap entirely: if the source
# changes, the tag changes, kubelet sees a never-pulled reference and
# fetches it; if the source is identical, the same digest serves both
# Tilt runs without a re-push. PullIfNotPresent is correct for these tags.
DOWNLOADER_SRC = ROOT + '/images/artifact-downloader'

# Register a watch on every file under DOWNLOADER_SRC so Tilt re-evaluates
# this Tiltfile (and recomputes DOWNLOADER_HASH below) when any downloader
# source file changes. Without this, the hash is frozen at the time Tilt
# was first launched: the local_resource would still build & push fresh
# content, but it would push it under a stale tag, and the operator's
# LDFLAGS would point at that same stale tag forever — defeating the
# whole point of content-addressing.
_downloader_files = str(local(
    "find . -type f -not -path './.*' | sort",
    quiet=True,
    dir=DOWNLOADER_SRC,
)).strip().split("\n")
for _f in _downloader_files:
    if _f:
        # Strip the leading "./" produced by find so we can rejoin against
        # DOWNLOADER_SRC without doubling the prefix.
        _rel = _f[2:] if _f.startswith("./") else _f
        read_file(DOWNLOADER_SRC + "/" + _rel)

DOWNLOADER_HASH = str(local(
    "find . -type f -not -path './.*' | sort | xargs sha256sum | sha256sum | cut -c1-12",
    quiet=True,
    dir=DOWNLOADER_SRC,
)).strip()
DOWNLOADER_TAG = "tilt-" + DOWNLOADER_HASH
DOWNLOAD_IMAGE = "ttl.sh/aim-placeholder/aim-artifact-downloader:" + DOWNLOADER_TAG
print("Baking DefaultDownloadImage=%s into operator binary" % DOWNLOAD_IMAGE)

# Tilt's docker_build only pushes images that some k8s resource references
# (it scans Pod specs for matches). The downloader is referenced at runtime
# by the operator binary via LDFLAGS, which Tilt can't see — so we drive the
# build/push ourselves with a local_resource. The content hash above means
# the build is a no-op when nothing changed (docker reuses cached layers,
# the push is a no-op when ttl.sh already has the digest).
local_resource(
    'artifact-downloader-image',
    cmd='docker build -t ' + DOWNLOAD_IMAGE + ' ' + DOWNLOADER_SRC + ' && docker push ' + DOWNLOAD_IMAGE,
    deps=[DOWNLOADER_SRC],
    labels=['setup'],
    allow_parallel=True,
)

LDFLAGS = "-X 'github.com/amd-enterprise-ai/aim-engine/api/v1alpha1.DefaultDownloadImage=" + DOWNLOAD_IMAGE + "'"

# ============================================================================
# Build Configuration
# ============================================================================

# Determine which Dockerfile target to use
TARGET = "debug" if DEBUG_MODE else "dev"

if DEBUG_MODE:
    print("=" * 60)
    print("DEBUG MODE")
    print("Delve listening on port 2345")
    print("Connect: dlv connect localhost:2345")
    print("=" * 60)

    # Debug build with Delve
    docker_build_with_restart(
        IMAGE_NAME,
        context=ROOT,
        dockerfile='Dockerfile',
        target='debug',
        build_args={'DOWNLOAD_IMAGE': DOWNLOAD_IMAGE},
        entrypoint=[
            '/go/bin/dlv', 'exec', '/manager',
            '--headless', '--listen=:2345',
            '--api-version=2', '--accept-multiclient',
            '--continue', '--'
        ],
        live_update=[
            # Sync Go source files
            sync(ROOT + '/cmd', '/workspace/cmd'),
            sync(ROOT + '/internal', '/workspace/internal'),
            sync(ROOT + '/api', '/workspace/api'),
            sync(ROOT + '/go.mod', '/workspace/go.mod'),
            sync(ROOT + '/go.sum', '/workspace/go.sum'),
            # Rebuild binary with debug flags
            run(
                'cd /workspace && CGO_ENABLED=0 go build -gcflags="all=-N -l" -ldflags "' + LDFLAGS + '" -o /manager ./cmd/main.go',
                trigger=[ROOT + '/cmd/', ROOT + '/internal/', ROOT + '/api/']
            ),
        ],
    )
else:
    print("=" * 60)
    print("NORMAL MODE")
    print("Fast in-container rebuilds")
    print("=" * 60)

    # Normal build - optimized binary
    docker_build_with_restart(
        IMAGE_NAME,
        context=ROOT,
        dockerfile='Dockerfile',
        target='dev',
        build_args={'DOWNLOAD_IMAGE': DOWNLOAD_IMAGE},
        entrypoint=['/manager'],
        live_update=[
            # Sync Go source files
            sync(ROOT + '/cmd', '/workspace/cmd'),
            sync(ROOT + '/internal', '/workspace/internal'),
            sync(ROOT + '/api', '/workspace/api'),
            sync(ROOT + '/go.mod', '/workspace/go.mod'),
            sync(ROOT + '/go.sum', '/workspace/go.sum'),
            # Rebuild binary
            run(
                'cd /workspace && CGO_ENABLED=0 go build -ldflags "' + LDFLAGS + '" -o /manager ./cmd/main.go',
                trigger=[ROOT + '/cmd/', ROOT + '/internal/', ROOT + '/api/']
            ),
        ],
    )

# ============================================================================
# Kubernetes Resources
# ============================================================================

# Generate deployment with our customizations (PVC for build cache, image override)
k8s_yaml(kustomize('kustomize'))

# Configure the main deployment. resource_deps ensures the downloader
# image is pushed to ttl.sh BEFORE the operator pod tries to spawn any
# download Job referencing it; without this, a race on first startup
# could create download Jobs pointing at a tag that hasn't been pushed
# yet, producing transient ImagePullBackOff loops.
k8s_resource(
    'aim-engine-controller-manager',
    port_forwards=[
        port_forward(8081, 8081, name='health'),
        port_forward(8080, 8080, name='metrics'),
    ] + ([port_forward(2345, 2345, name='delve')] if DEBUG_MODE else []),
    labels=['aim-engine'],
    resource_deps=['artifact-downloader-image'],
)

# ============================================================================
# Local Resources
# ============================================================================

# Generate manifests - runs when API types change
# This regenerates CRDs and deepcopy methods
local_resource(
    'generate-manifests',
    cmd='cd ' + ROOT + ' && mise exec -- make manifests generate',
    deps=[
        ROOT + '/api/v1alpha1',
    ],
    ignore=[
        ROOT + '/api/v1alpha1/zz_generated.deepcopy.go',
    ],
    labels=['setup'],
    allow_parallel=True,
)

# ============================================================================
# Testing Resources (manual trigger)
# ============================================================================

# Run unit tests on demand
local_resource(
    'unit-tests',
    cmd='cd ' + ROOT + ' && mise exec -- go test $(go list ./... | grep -v /e2e) -short',
    labels=['testing'],
    auto_init=False,
    trigger_mode=TRIGGER_MODE_MANUAL,
    allow_parallel=True,
)

# Run linting on demand
local_resource(
    'lint',
    cmd='cd ' + ROOT + ' && mise exec -- golangci-lint run --timeout 5m',
    labels=['testing'],
    auto_init=False,
    trigger_mode=TRIGGER_MODE_MANUAL,
    allow_parallel=True,
)

# Run chainsaw e2e tests on demand
local_resource(
    'test-chainsaw',
    cmd='cd ' + ROOT + ' && mise exec -- make test-chainsaw',
    labels=['testing'],
    auto_init=False,
    trigger_mode=TRIGGER_MODE_MANUAL,
    allow_parallel=True,
    resource_deps=['aim-engine-controller-manager'],
)

# Run focused chainsaw tests from .local/{branch}/feature.yaml
local_resource(
    'test-chainsaw-feature',
    cmd='cd ' + ROOT + ' && mise exec -- make test-chainsaw-feature',
    labels=['testing'],
    auto_init=False,
    trigger_mode=TRIGGER_MODE_MANUAL,
    allow_parallel=True,
    resource_deps=['aim-engine-controller-manager'],  # Ensure controller is running
)
