---
# Kind-specific dependencies
# Provides NFS-based RWX storage class for local testing via csi-driver-nfs
# and a lightweight kernel NFS server (nfs-server-alpine).
repositories:
  - name: csi-driver-nfs
    url: https://raw.githubusercontent.com/kubernetes-csi/csi-driver-nfs/master/charts

releases:
  - name: csi-driver-nfs
    namespace: kube-system
    chart: csi-driver-nfs/csi-driver-nfs
    version: 4.12.0
    wait: true
    timeout: 300
    values:
      - storageClasses:
          - name: nfs
            annotations:
              storageclass.kubernetes.io/is-default-class: "true"
            parameters:
              server: nfs-server.nfs-system.svc.cluster.local
              share: /
            reclaimPolicy: Delete
            volumeBindingMode: Immediate
            mountOptions:
              - nfsvers=4
    hooks:
      - events: ["presync"]
        showlogs: true
        command: sh
        args:
          - -c
          - |
            kubectl apply -f nfs-server.yaml
            kubectl wait --for=condition=Ready --timeout=120s pod -l app=nfs-server -n nfs-system
      - events: ["postsync"]
        showlogs: true
        command: kubectl
        args:
          - patch
          - storageclass
          - standard
          - -p
          - '{"metadata": {"annotations":{"storageclass.kubernetes.io/is-default-class":"false"}}}'
