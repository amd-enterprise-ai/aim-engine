...@_theme
direction: right

ModelSource: AIMClusterModelSource {class: user}
AIMModel: "AIMModel /\nAIMClusterModel" {class: user}
ProfileSet: "AIMProfileSet /\nAIMClusterProfileSet" {class: user}
RuntimeConfig: "AIMRuntimeConfig /\nAIMClusterRuntimeConfig" {class: user}
HandProfile: "AIMProfile\n(hand-authored)" {class: user}

ModelCtrl: Model controller {class: operator}
ProfileSetCtrl: Profile-set controller {class: operator}
ProfileCtrl: Profile controller {class: operator}

Discovery: "Discovery Job +\nConfigMap" {class: managed}
Definitions: "Discovered model definitions\n(complete catalog)" {class: managed}
Copyable: "Copyable profile resources\n(direct, generated, derived)" {class: user}
Profile: "Materialised AIMProfile /\nAIMClusterProfile" {class: resolved}

ModelSource -> AIMModel: discovers / declares
AIMModel -> ModelCtrl
ModelCtrl -> Discovery: spec.image
RuntimeConfig -> ModelCtrl: generated fallback
ModelCtrl -> Profile: spec.modelId
ModelCtrl -> ProfileSetCtrl: spec.profiles
ProfileSet -> ProfileSetCtrl
Discovery -> Definitions: complete catalog
Discovery -> Profile: supported entries (image only)
Discovery -> ProfileSetCtrl: explicit catalog sourceRef
Definitions -> ProfileSetCtrl: external source selection
Copyable -> ProfileSetCtrl: external source selection
ProfileSetCtrl -> Profile: derives
HandProfile -> ProfileCtrl
ProfileCtrl -> Profile: reconciles
