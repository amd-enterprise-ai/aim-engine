...@_theme
direction: right

ModelSource: AIMClusterModelSource {class: user}
AIMModel: "AIMModel /\nAIMClusterModel" {class: user}
ProfileSet: "AIMProfileSet /\nAIMClusterProfileSet" {class: user}
HandProfile: "AIMProfile\n(hand-authored)" {class: user}

ModelCtrl: Model controller {class: operator}
ProfileSetCtrl: Profile-set controller {class: operator}
ProfileCtrl: Profile controller {class: operator}

Discovery: "Discovery Job +\nConfigMap" {class: managed}
Profile: "AIMProfile /\nAIMClusterProfile\n(deployable)" {class: resolved}

ModelSource -> AIMModel: discovers
AIMModel -> ModelCtrl
ModelCtrl -> Discovery: image discovery
ModelCtrl -> ProfileSetCtrl: derivation
ProfileSet -> ProfileSetCtrl
Discovery -> Profile: yields
ProfileSetCtrl -> Profile: derives
HandProfile -> ProfileCtrl
ProfileCtrl -> Profile: reconciles
